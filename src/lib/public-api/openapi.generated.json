{
  "openapi": "3.1.0",
  "info": {
    "title": "Proxima Public API",
    "version": "1.0.0",
    "description": "Versioned HTTP surface for **Canonical exercises**, **Custom exercises**, and history-only **Workouts**. GET /api/v1/exercises is world-readable. Writes use a **Proxima API key** (`Authorization: Bearer`)."
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "This host"
    }
  ],
  "components": {
    "securitySchemes": {
      "proximaApiKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "pxa_",
        "description": "Proxima API key minted once in account settings. Optional on GET /api/v1/exercises; required on writes."
      }
    },
    "schemas": {
      "PublicApiExerciseListQuery": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1,
            "description": "1-based page."
          },
          "page_size": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "PublicApiExerciseList": {
        "type": "object",
        "properties": {
          "exercises": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicApiExercise"
            }
          },
          "page": {
            "type": "integer"
          },
          "page_size": {
            "type": "integer"
          },
          "has_more": {
            "type": "boolean"
          }
        },
        "required": [
          "exercises",
          "page",
          "page_size",
          "has_more"
        ]
      },
      "PublicApiError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "PublicApiCreateCustomExercise": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "Display title. Duplicate normalized title for this user returns the existing id."
          },
          "exercise_type": {
            "type": "string",
            "description": "Same slugs as the in-app Hevy create form."
          },
          "equipment": {
            "type": "string",
            "description": "Same slugs as the in-app Hevy create form (`equipment_category`)."
          },
          "primary_muscle_group": {
            "type": "string",
            "description": "Same slugs as the in-app Hevy create form (`muscle_group`)."
          },
          "secondary_muscle_groups": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Other muscles. Same slugs as primary."
          }
        },
        "required": [
          "title",
          "exercise_type",
          "equipment",
          "primary_muscle_group"
        ]
      },
      "PublicApiCreatedExercise": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Canonical exercise ID. Use as `canonical_exercise_id` on a Workout."
          }
        },
        "required": [
          "id"
        ]
      },
      "PublicApiWorkoutId": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Proxima Workout backup id."
          }
        },
        "required": [
          "id"
        ]
      },
      "PublicApiWorkout": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Proxima Workout backup id."
          },
          "source": {
            "type": "string"
          },
          "external_id": {
            "type": "string"
          },
          "started_at": {
            "type": "string"
          },
          "ended_at": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "exercises": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "canonical_exercise_id": {
                  "type": "string",
                  "format": "uuid",
                  "description": "ID from GET /api/v1/exercises or POST /api/v1/exercises."
                },
                "notes": {
                  "type": "string",
                  "nullable": true
                },
                "sets": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "set_type": {
                        "type": "string",
                        "description": "normal, warmup, dropset, or failure."
                      },
                      "weight_kg": {
                        "type": "number",
                        "nullable": true
                      },
                      "reps": {
                        "type": "number",
                        "nullable": true
                      },
                      "duration_seconds": {
                        "type": "number",
                        "nullable": true
                      },
                      "distance_meters": {
                        "type": "number",
                        "nullable": true
                      },
                      "rpe": {
                        "type": "number",
                        "nullable": true
                      },
                      "custom_metric": {
                        "type": "number",
                        "nullable": true
                      },
                      "rep_range_start": {
                        "type": "number",
                        "nullable": true
                      },
                      "rep_range_end": {
                        "type": "number",
                        "nullable": true
                      }
                    },
                    "required": [
                      "set_type",
                      "weight_kg",
                      "reps",
                      "duration_seconds",
                      "distance_meters",
                      "rpe",
                      "custom_metric",
                      "rep_range_start",
                      "rep_range_end"
                    ]
                  }
                }
              },
              "required": [
                "canonical_exercise_id",
                "sets",
                "notes"
              ]
            }
          }
        },
        "required": [
          "id",
          "source",
          "external_id",
          "started_at",
          "ended_at",
          "title",
          "description",
          "exercises"
        ]
      },
      "PublicApiReplaceWorkout": {
        "type": "object",
        "properties": {
          "started_at": {
            "type": "string",
            "description": "ISO 8601 start."
          },
          "ended_at": {
            "type": "string",
            "description": "ISO 8601 end. Must be at or after started_at."
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "exercises": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicApiWorkoutExercise"
            },
            "minItems": 1
          }
        },
        "required": [
          "started_at",
          "ended_at",
          "title",
          "exercises"
        ]
      },
      "empty": {},
      "PublicApiCreateWorkout": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "description": "Closed Workout source list. hevy is rejected."
          },
          "external_id": {
            "type": "string",
            "minLength": 1,
            "description": "Caller identity for this session. Unique with source per athlete."
          },
          "started_at": {
            "type": "string",
            "description": "ISO 8601 start."
          },
          "ended_at": {
            "type": "string",
            "description": "ISO 8601 end. Must be at or after started_at."
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "exercises": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicApiWorkoutExercise"
            },
            "minItems": 1,
            "description": "At least one exercise."
          }
        },
        "required": [
          "source",
          "external_id",
          "started_at",
          "ended_at",
          "title",
          "exercises"
        ]
      },
      "PublicApiCreatedWorkout": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Proxima Workout backup id."
          }
        },
        "required": [
          "id"
        ]
      },
      "PublicApiExercise": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Canonical exercise ID. Use as `canonical_exercise_id` on a Workout."
          },
          "title": {
            "type": "string"
          },
          "exercise_type": {
            "type": "string",
            "nullable": true
          },
          "equipment": {
            "type": "string",
            "nullable": true
          },
          "primary_muscle_group": {
            "type": "string",
            "nullable": true
          },
          "secondary_muscle_groups": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          }
        },
        "required": [
          "id",
          "title",
          "exercise_type",
          "equipment",
          "primary_muscle_group",
          "secondary_muscle_groups"
        ]
      },
      "PublicApiWorkoutSet": {
        "type": "object",
        "properties": {
          "set_type": {
            "type": "string",
            "description": "normal, warmup, dropset, or failure."
          },
          "weight_kg": {
            "type": "number",
            "nullable": true
          },
          "reps": {
            "type": "number",
            "nullable": true
          },
          "duration_seconds": {
            "type": "number",
            "nullable": true
          },
          "distance_meters": {
            "type": "number",
            "nullable": true
          },
          "rpe": {
            "type": "number",
            "nullable": true
          },
          "custom_metric": {
            "type": "number",
            "nullable": true
          },
          "rep_range_start": {
            "type": "number",
            "nullable": true
          },
          "rep_range_end": {
            "type": "number",
            "nullable": true
          }
        },
        "required": [
          "set_type"
        ]
      },
      "PublicApiWorkoutExercise": {
        "type": "object",
        "properties": {
          "canonical_exercise_id": {
            "type": "string",
            "format": "uuid",
            "description": "ID from GET /api/v1/exercises or POST /api/v1/exercises."
          },
          "notes": {
            "type": "string",
            "description": "Exercise-level notes."
          },
          "sets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicApiWorkoutSet"
            },
            "minItems": 1,
            "description": "At least one set."
          }
        },
        "required": [
          "canonical_exercise_id",
          "sets"
        ]
      }
    },
    "responses": {}
  },
  "paths": {
    "/exercises": {
      "get": {
        "operationId": "listExercises",
        "summary": "List Canonical exercises",
        "description": "Paginated globals (`user_id` null). A valid Proxima API keyalso returns that user's Custom exercises. Never another user's. No key required.",
        "tags": [
          "Exercises"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer",
              "description": "1-based page."
            },
            "required": false,
            "description": "1-based page."
          },
          {
            "in": "query",
            "name": "page_size",
            "schema": {
              "type": "integer"
            },
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "A page of exercises the caller may read.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicApiExerciseList"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicApiError"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicApiError"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicApiError"
                }
              }
            }
          },
          "503": {
            "description": "HTTP 503",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicApiError"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createCustomExercise",
        "summary": "Create a Custom exercise",
        "description": "Key required. Required: title, exercise type, equipment, primary muscle. Optional: other muscles. Same enums as the in-app Hevy form. Duplicate normalized title for this user returns the existing id (200). Never inserts a global.",
        "tags": [
          "Exercises"
        ],
        "parameters": [],
        "security": [
          {
            "proximaApiKey": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PublicApiCreateCustomExercise"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Canonical exercise ID. Use as `canonical_exercise_id` on a Workout.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicApiCreatedExercise"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicApiError"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicApiError"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicApiError"
                }
              }
            }
          },
          "503": {
            "description": "HTTP 503",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicApiError"
                }
              }
            }
          }
        }
      }
    },
    "/workouts": {
      "post": {
        "operationId": "createWorkout",
        "summary": "Create a Workout",
        "description": "Key required. First-write-wins on source + external_id. Same identity + same body → 200 existing id. Same identity + different body → 409. Rejects hevy, unknown source, routine_id, empty exercises/sets, and unread canonical_exercise_id. Persists routine_id null so the row cannot participate in Day complete.",
        "tags": [
          "Workouts"
        ],
        "parameters": [],
        "security": [
          {
            "proximaApiKey": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PublicApiCreateWorkout"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Proxima Workout backup id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicApiCreatedWorkout"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicApiError"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicApiError"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicApiError"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicApiError"
                }
              }
            }
          },
          "503": {
            "description": "HTTP 503",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicApiError"
                }
              }
            }
          }
        }
      }
    },
    "/workouts/{id}": {
      "get": {
        "operationId": "getWorkout",
        "summary": "Get a Workout",
        "description": "Key required. Returns one Workout the key holder owns. Missing or another user's id is 404.",
        "tags": [
          "Workouts"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "string",
              "description": "Proxima Workout backup id."
            },
            "required": true,
            "description": "Proxima Workout backup id.",
            "example": "123"
          }
        ],
        "security": [
          {
            "proximaApiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicApiWorkout"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicApiError"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicApiError"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicApiError"
                }
              }
            }
          },
          "503": {
            "description": "HTTP 503",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicApiError"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "replaceWorkout",
        "summary": "Replace a Workout",
        "description": "Key required. Full-replaces title, times, description, exercises, and sets. source and external_id stay. routine_id stays null.",
        "tags": [
          "Workouts"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "string",
              "description": "Proxima Workout backup id."
            },
            "required": true,
            "description": "Proxima Workout backup id.",
            "example": "123"
          }
        ],
        "security": [
          {
            "proximaApiKey": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PublicApiReplaceWorkout"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicApiWorkout"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicApiError"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicApiError"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicApiError"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicApiError"
                }
              }
            }
          },
          "503": {
            "description": "HTTP 503",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicApiError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteWorkout",
        "summary": "Delete a Workout",
        "description": "Key required. Hard-deletes the Workout. Exercises and sets cascade.",
        "tags": [
          "Workouts"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "string",
              "description": "Proxima Workout backup id."
            },
            "required": true,
            "description": "Proxima Workout backup id.",
            "example": "123"
          }
        ],
        "security": [
          {
            "proximaApiKey": []
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicApiError"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicApiError"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicApiError"
                }
              }
            }
          },
          "503": {
            "description": "HTTP 503",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicApiError"
                }
              }
            }
          }
        }
      }
    }
  }
}