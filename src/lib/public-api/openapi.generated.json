{
  "openapi": "3.1.0",
  "info": {
    "title": "Proxima Public API",
    "version": "1.0.0",
    "description": "Versioned HTTP surface for **Canonical exercises**, **Custom movements**, and history-only **Workouts**. GET /api/v1/exercises is world-readable. Writes use a **Proxima API key** (`Authorization: Bearer`)."
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "This host"
    }
  ],
  "components": {
    "securitySchemes": {
      "proximaApiKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "pxa_",
        "description": "Proxima API key minted once in account settings. Optional on GET /api/v1/exercises; required on writes."
      }
    },
    "schemas": {
      "PublicApiExerciseListQuery": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1,
            "description": "1-based page."
          },
          "page_size": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "PublicApiExerciseList": {
        "type": "object",
        "properties": {
          "exercises": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicApiExercise"
            }
          },
          "page": {
            "type": "integer"
          },
          "page_size": {
            "type": "integer"
          },
          "has_more": {
            "type": "boolean"
          }
        },
        "required": [
          "exercises",
          "page",
          "page_size",
          "has_more"
        ]
      },
      "PublicApiError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "PublicApiExercise": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Canonical exercise ID. Use as `canonical_exercise_id` on a Workout."
          },
          "title": {
            "type": "string"
          },
          "exercise_type": {
            "type": "string",
            "nullable": true
          },
          "equipment": {
            "type": "string",
            "nullable": true
          },
          "primary_muscle_group": {
            "type": "string",
            "nullable": true
          },
          "secondary_muscle_groups": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          }
        },
        "required": [
          "id",
          "title",
          "exercise_type",
          "equipment",
          "primary_muscle_group",
          "secondary_muscle_groups"
        ]
      }
    },
    "responses": {}
  },
  "paths": {
    "/exercises": {
      "get": {
        "operationId": "listExercises",
        "summary": "List Canonical exercises",
        "description": "Paginated globals (`user_id` null). A valid Proxima API keyalso returns that user's Custom movements. Never another user's. No key required.",
        "tags": [
          "Exercises"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer",
              "description": "1-based page."
            },
            "required": false,
            "description": "1-based page."
          },
          {
            "in": "query",
            "name": "page_size",
            "schema": {
              "type": "integer"
            },
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "A page of exercises the caller may read.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicApiExerciseList"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicApiError"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicApiError"
                }
              }
            }
          }
        }
      }
    }
  }
}