{
    "name": "proxima",
    "private": true,
    "packageManager": "npm@11.19.1",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "prepare": "husky",
        "build": "turbo run build",
        "dev": "turbo run dev --filter=landing",
        "lint": "turbo run lint --filter=landing",
        "test:ci": "turbo run test:ci --filter=landing"
    },
    "devDependencies": {
        "husky": "^9.1.7",
        "turbo": "^2.5.4"
    },
    "engines": {
        "node": ">=22"
    },
    "overrides": {
        "ai": "$ai",
        "@types/react": "19.2.8",
        "@types/react-dom": "19.2.3",
        "@payloadcms/next": {
            "next": "$next"
        },
        "payload": "^3.72.0",
        "lodash": "4.18.1",
        "lodash-es": "4.18.1"
    }
}
